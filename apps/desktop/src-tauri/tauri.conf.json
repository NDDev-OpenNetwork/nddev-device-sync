{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NDDev Device Sync",
  "version": "0.0.1",
  "identifier": "com.nddev.device-sync",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NDDev Device Sync",
        "width": 900,
        "height": 650,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": false
  }
}
